APP_ENV=local
VECTOR_STORE=chroma
CHROMA_PATH=chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=local-model
LLM_TEMPERATURE=0.0
# Cloud answer LLM (Phase 5A, opt-in). LLM_PROVIDER=bedrock enables it;
# credentials always come from the AWS chain (env/instance role) — there
# is deliberately no key setting here. ANSWER_MODEL_ID has no default:
# set a Bedrock model or inference-profile ID explicitly.
# LLM_PROVIDER=bedrock
# ANSWER_MODEL_ID=
# BEDROCK_REGION=us-east-1
# Preserved behaviour (do not change in Phase 1)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=5
RELEVANCE_THRESHOLD=0.3
# PostgreSQL/pgvector (Phase 2, only used when VECTOR_STORE=postgres).
# Connect via SSH tunnel: localhost:15432 -> rag4i-admin -> rag4i-db:5432.
# RDS stays private. Never commit real credentials (.env is git-ignored).
# Either set DATABASE_URL or the DB_* parts (DATABASE_URL wins if set).
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:15432/rag4i
DB_HOST=localhost
DB_PORT=15432
DB_NAME=rag4i
DB_USER=
DB_PASSWORD=
# Document storage (Phase 3). Local default; S3 opt-in via config only.
# Bucket/prefix come from config, never hardcoded. Never commit credentials.
DOCUMENT_STORAGE=local
S3_BUCKET=
S3_REGION=ap-south-2
S3_PREFIX=documents/
# Session uploads (Phase 5C): local staging root for per-session files.
# S3 mode stores session objects under sessions/<session-id>/uploads/
# inside the same private bucket (no extra configuration).
# SESSION_STORAGE_DIR=session_uploads
# Query planner / reasoning LLM (Phase 5D, opt-in). Disabled by default;
# REASONING_ENABLED=0 reproduces the exact 4.12 behavior. Reasoning model
# and region are independent from the answer configuration above.
# REASONING_ENABLED=0
# REASONING_PROVIDER=bedrock
# REASONING_MODEL_ID=
# REASONING_REGION=us-east-1
# REASONING_TIMEOUT_S=5
# Answer reviewer / bounded repair (Phase 5E, opt-in). Disabled by
# default; REVIEW_ENABLED=0 preserves the pre-5E answer behavior.
# Reviewer provider/model/region/timeout stay independent from the
# answer and reasoning configuration above. REVIEW_ALWAYS_IF_CONFIGURED=1
# reviews every generated answer when enabled (default reviews only on
# citation-guard flags, comparison, or summary).
# REVIEW_ENABLED=0
# REVIEW_PROVIDER=bedrock
# REVIEW_MODEL_ID=
# REVIEW_REGION=us-east-1
# REVIEW_TIMEOUT_S=5
# REVIEW_ALWAYS_IF_CONFIGURED=0
