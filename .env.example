APP_ENV=local
VECTOR_STORE=chroma
CHROMA_PATH=chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=local-model
LLM_TEMPERATURE=0.0
# Preserved behaviour (do not change in Phase 1)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=5
RELEVANCE_THRESHOLD=0.3
# PostgreSQL/pgvector (Phase 2, only used when VECTOR_STORE=postgres).
# Connect via SSH tunnel: localhost:15432 -> rag4i-admin -> rag4i-db:5432.
# RDS stays private. Never commit real credentials (.env is git-ignored).
# Either set DATABASE_URL or the DB_* parts (DATABASE_URL wins if set).
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:15432/rag4i
DB_HOST=localhost
DB_PORT=15432
DB_NAME=rag4i
DB_USER=
DB_PASSWORD=
