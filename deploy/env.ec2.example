# RAG-4i-Cloud on EC2 (operator fills secrets on the instance only).
# Copy to /home/ec2-user/RAG-4i-Cloud/.env and set real values.
# Never commit this file (.env is git-ignored).

APP_ENV=prod
VECTOR_STORE=postgres
DOCUMENT_STORAGE=s3

# RDS is private in the same VPC: connect directly, no tunnel needed.
DB_HOST=rag4i-db.c8j82eu4atyt.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=rag4i
DB_USER=rag4iadmin
DB_PASSWORD=

# Existing private S3 bucket (IAM role on EC2 provides credentials; no keys here).
S3_BUCKET=rag4i-company-documents-305740358559-ap-south-2-an
S3_REGION=ap-south-2
S3_PREFIX=documents/

# LM Studio reaches EC2 via the operator's reverse SSH tunnel
# (see README Phase 4); EC2 connects to its own localhost:1234.
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=local-model
LLM_TEMPERATURE=0.0

# Preserved behaviour — do not change.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=5
RELEVANCE_THRESHOLD=0.3
EMBEDDING_MODEL=all-MiniLM-L6-v2
